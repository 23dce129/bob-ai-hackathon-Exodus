# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is already in .gitignore
#
# Usage:
#   cp .env.example .env
#   Then edit .env with your real credentials

# =============================================================================
# IBM watsonx.ai  (required for AI-generated explanations and narratives)
# Get these from: https://cloud.ibm.com/  →  watsonx.ai project settings
# =============================================================================
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# =============================================================================
# Backend API
# =============================================================================
APP_PORT=8000
APP_ENV=development

# =============================================================================
# MCP Server
# The MCP server calls the backend API at this URL.
# Change only if you run the backend on a non-default port.
# =============================================================================
PHARMAGUARD_API_URL=http://localhost:8000
MCP_SERVER_PORT=8001

# MCP server behaviour (optional — defaults shown)
# Maximum number of signals / sections returned per tool call
PHARMAGUARD_MCP_MAX_RESULTS=10
# HTTP timeout (seconds) for MCP → backend calls
PHARMAGUARD_MCP_TIMEOUT=30
